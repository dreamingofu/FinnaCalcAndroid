<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive launcher icon. The foreground is the app's own 1024px icon,
  scaled into the 66% safe zone so a launcher can mask it to any shape without
  clipping the mark; the background is the icon's own field colour, so the
  masked area matches the art instead of guessing at one.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
